# OpenAI
OPENAI_API_KEY=sk-...

# ElevenLabs (optional fallback TTS — leave blank to use OpenAI TTS only)
ELEVEN_API_KEY=sk_...

# fal.ai (thumbnail generation — https://fal.ai/dashboard/keys)
FAL_KEY=...

# Groq (fast research/ideation)
GROQ_API_KEY=gsk_...

# Channel config (optional — defaults shown)
CHANNEL_NICHE=personal finance
CHANNEL_TONE=authoritative
CHANNEL_DEMOGRAPHIC=25-45 year old professionals
POSTING_CADENCE=3

# Output directories (optional — defaults shown)
OUTPUT_DIR=./output
AUDIO_DIR=./output/audio
THUMBNAIL_DIR=./output/thumbnails
SCRIPT_DIR=./output/scripts

# n8n integration (optional)
N8N_WEBHOOK_URL=
N8N_API_KEY=
